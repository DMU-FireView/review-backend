# ─────────────────────────────────────────────────────────────
# EC2 운영 서버용 환경변수 템플릿
#
# 사용법 (EC2에서):
#   cp .env.prod.example .env.prod
#   vi .env.prod          # <  > 부분을 실제 값으로 교체
#   chmod 600 .env.prod
#
# 주의:
#   - 값에 따옴표를 쓰지 말 것 (Docker가 따옴표까지 값으로 인식함)
#   - 값 뒤에 # 주석을 붙이지 말 것 (주석은 줄 맨 앞에만)
#   - 특수문자(! $ @ 등)는 이스케이프 없이 그대로 입력
#   - 이 파일을 복사한 .env.prod 는 절대 커밋하지 말 것
# ─────────────────────────────────────────────────────────────


# ── [필수] Database (RDS PostgreSQL) ─────────────────────────
# RDS 콘솔 → 데이터베이스 → 연결 & 보안 → 엔드포인트
# 형식: jdbc:postgresql://<엔드포인트>:5432/<DB이름>
DB_URL=jdbc:postgresql://<RDS-엔드포인트>:5432/fireview
DB_USERNAME=<RDS-마스터-사용자명>
DB_PASSWORD=<RDS-마스터-암호>


# ── [필수] JWT 서명키 ─────────────────────────────────────────
# 생성: openssl rand -base64 48
# 이 값이 바뀌면 기존 발급된 토큰이 전부 무효화됨
JWT_SECRET=<openssl로-생성한-값>


# ── [필수] Google OAuth2 ─────────────────────────────────────
# https://console.cloud.google.com → API 및 서비스 → 사용자 인증 정보
# 승인된 리디렉션 URI 에 아래를 등록해야 함:
#   https://<백엔드도메인>/login/oauth2/code/google
GOOGLE_CLIENT_ID=<xxxxx.apps.googleusercontent.com>
GOOGLE_CLIENT_SECRET=<구글-클라이언트-시크릿>


# ── [필수] Naver ─────────────────────────────────────────────
# https://developers.naver.com → 내 애플리케이션
# Callback URL 에 아래를 등록해야 함:
#   https://<백엔드도메인>/login/oauth2/code/naver
#
# ⚠️ 이 두 값은 "네이버 로그인"과 "네이버 쇼핑 검색 API" 양쪽에 함께 쓰인다.
#    따라서 네이버 개발자센터에서 하나의 애플리케이션에
#    [네이버 로그인] + [검색] API 를 모두 추가해 두어야 한다.
#    (앱을 두 개로 나눠 만들면 한쪽 기능이 동작하지 않음)
NAVER_CLIENT_ID=<네이버-클라이언트-ID>
NAVER_CLIENT_SECRET=<네이버-클라이언트-시크릿>


# ── [필수] CORS / 리다이렉트 ──────────────────────────────────
# 프론트엔드 오리진 목록. 쉼표로 구분, 공백 없이, 끝에 슬래시 없이
CORS_ALLOWED_ORIGINS=https://<프론트도메인>,https://www.<프론트도메인>

# 소셜 로그인 성공 후 프론트로 돌려보낼 주소
OAUTH2_REDIRECT_URI=https://<프론트도메인>/oauth2/callback


# ── [필수] 메일 (SMTP) ────────────────────────────────────────
# 비밀번호 재설정 메일 발송에 사용
# Gmail 사용 시: 2단계 인증 활성화 후 "앱 비밀번호"를 발급받아야 함
#   (일반 계정 비밀번호로는 인증 실패)
MAIL_HOST=smtp.gmail.com
MAIL_USERNAME=<발신-계정@gmail.com>
MAIL_PASSWORD=<앱-비밀번호-16자리>


# ── [필수] LLM 챗봇 ──────────────────────────────────────
# Codyssey 게이트웨이를 쓰면 BASE_URL 을 게이트웨이 주소로 지정한다.
# 비워두면 Anthropic 에 직접 호출한다.
# MODEL 은 게이트웨이가 쓰는 모델 식별자를 그대로 넣는다.
LLM_API_KEY=<Codyssey에서-발급한-API-키>
LLM_BASE_URL=<게이트웨이-주소>
LLM_MODEL=claude-sonnet-4
# 응답 상한. 쿼터 절약을 위해 낮게 유지한다.
LLM_MAX_TOKENS=600
LLM_TIMEOUT_SECONDS=60

# Data 서버 연동 전까지 챗봇이 쓰는 임시 분석 컨텍스트.
# Data 서버 조회 어댑터가 들어오면 false 로 바꾼다.
CHAT_STUB_ANALYSIS=true


# ── [필수] 서버 간 호출 토큰 ──────────────────────────────────
# Data 서버가 완료 웹훅을 보낼 때 X-Service-Token 헤더에 싣는 값.
# Data 서버 환경변수에도 같은 값을 넣어야 한다.
# 생성: openssl rand -base64 32
SERVICE_TOKEN=<openssl로-생성한-값>


# ── [권장] Redis ─────────────────────────────────────────────
# EC2 호스트에서 실행 중인 Redis 에 컨테이너가 접근하는 주소.
# localhost 는 컨테이너 자신을 가리키므로 사용 불가.
# Docker 브리지 게이트웨이 IP 를 넣는다 (확인: ip addr show docker0)
REDIS_HOST=172.17.0.1


# ── [선택] 나머지 ────────────────────────────────────────────
# 아래 값들은 코드에 기본값이 있어 생략 가능하지만,
# 새 서버에서는 명시해 두는 편이 안전하다.

# AI 분석 서버 주소
AI_SERVER_URL=http://20.249.211.171:8000

# 메일 발신 주소 / 포트
MAIL_PORT=587
MAIL_FROM=noreply@<도메인>

# 비밀번호 재설정 링크의 베이스 URL (뒤에 /reset-password 가 자동으로 붙음)
FRONTEND_URL=https://<프론트도메인>

# 챗봇 요금제별 하루 메시지 한도 (-1 은 무제한).
# 생략하면 각각 5 / 100 / 300 이 적용된다.
CHAT_QUOTA_FREE=5
CHAT_QUOTA_PLUS=100
CHAT_QUOTA_PRO=300

# PRO 전용 엔드포인트(/api/chat/pro/messages)가 쓸 모델.
# 비우면 LLM_MODEL 을 그대로 쓰고 출력 길이만 늘어난다.
LLM_PRO_MODEL=
LLM_PRO_MAX_TOKENS=1200

# ── Data 서버 (review-data) ──────────────────────────────
# 상품·리뷰 원본을 소유하는 서버. 비우면 상품 조회가 빈 값으로 떨어진다.
DATA_SERVER_URL=https://data.re-view.kr
# review-data 의 .env 에 설정된 INTERNAL_TOKEN 과 같은 값
DATA_SERVER_TOKEN=

# 챗봇이 Data 서버를 보게 하려면 false. 위 두 값을 채운 뒤에 바꾼다.
CHAT_STUB_ANALYSIS=true

# OAuth2 콜백을 받을 호스트. 비우면 https://re-view.kr 을 쓴다.
# 반드시 "브라우저가 보고 있는 호스트"(프론트)여야 한다. API 호스트가 아니다.
# state 쿠키가 그 호스트에만 저장되므로, 다르면 로그인이 실패한다.
OAUTH2_CALLBACK_BASE_URL=https://re-view.kr

# 상품 검색에 쓸 쇼핑몰 (쉼표 구분). 비우면 kurly,oliveyoung,musinsa,elevenst
DATA_SERVER_SEARCH_PLATFORMS=kurly,oliveyoung,musinsa,elevenst

# 홈 자동 채우기. 운영 기본값은 켜짐. 끄려면 false
# HOME_REFRESH_ENABLED=true
# 쉼표 구분. 비우면 application.properties 의 기본 목록
# HOME_REFRESH_KEYWORDS=선크림,마스크팩,샴푸,이어폰,라면
